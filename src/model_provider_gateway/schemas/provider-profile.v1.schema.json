{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lightcoloror/model-provider-gateway/schemas/provider-profile.v1.schema.json",
  "title": "Model Provider Gateway provider-profile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "profile_id", "provider_id", "protocol", "base_url", "auth_ref",
    "model", "deployment", "capabilities", "allowed_destinations", "timeout_seconds",
    "retry_policy", "cost_limits", "fallback_pool", "provider_options", "provenance",
    "last_verified", "advanced", "route_revision"
  ],
  "properties": {
    "schema": {"const": "model_provider_gateway.provider_profile.v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "protocol": {"enum": ["responses", "chat_completions", "messages", "audio_transcriptions", "ocr", "embeddings", "speech"]},
    "base_url": {"type": "string", "pattern": "^https://"},
    "auth_ref": {"type": "string", "pattern": "^(env|keyring|dpapi):[A-Za-z0-9_.:/-]+$"},
    "model": {"type": ["string", "null"]},
    "deployment": {"type": ["string", "null"]},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "vision", "asr", "tts", "embedding", "ocr"]}},
    "allowed_destinations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "retry_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "backoff_seconds", "retry_statuses"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "backoff_seconds": {"type": "number", "minimum": 0, "maximum": 60},
        "retry_statuses": {"type": "array", "uniqueItems": true, "items": {"enum": [429, 500, 502, 503, 504]}}
      }
    },
    "cost_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_calls", "max_cost_usd"],
      "properties": {
        "max_calls": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "fallback_pool": {"type": "array", "maxItems": 0},
    "provider_options": {"type": "object"},
    "provider_fields": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "provenance": {"type": "object", "required": ["preset_id", "preset_evidence", "catalog_schema"]},
    "last_verified": {"type": "string", "format": "date-time"},
    "advanced": {"type": "boolean"},
    "route_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "anyOf": [
    {"required": ["model"], "properties": {"model": {"type": "string", "minLength": 1}}},
    {"required": ["deployment"], "properties": {"deployment": {"type": "string", "minLength": 1}}}
  ]
}
