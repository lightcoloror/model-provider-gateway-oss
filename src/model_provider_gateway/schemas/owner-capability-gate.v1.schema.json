{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lightcoloror/model-provider-gateway/schemas/owner-capability-gate.v1.schema.json",
  "title": "Model Provider Gateway local owner capability gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "scope", "plan_id", "plan_revision", "capability", "adapter_id", "input_manifest_hash",
    "local_execution_authorized", "provider_call_authorized", "external_io_authorized",
    "automatic_fallback_allowed", "automatic_retry_allowed", "gate_revision"
  ],
  "properties": {
    "schema": {"const": "model_provider_gateway.owner_capability_gate.v1"},
    "scope": {"const": "local_synthetic_or_public_fixture"},
    "plan_id": {"type": "string"},
    "plan_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability": {"enum": ["asr", "ocr", "tts", "embedding"]},
    "adapter_id": {"type": "string"},
    "input_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "local_execution_authorized": {"const": true},
    "provider_call_authorized": {"const": false},
    "external_io_authorized": {"const": false},
    "automatic_fallback_allowed": {"const": false},
    "automatic_retry_allowed": {"const": false},
    "gate_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
