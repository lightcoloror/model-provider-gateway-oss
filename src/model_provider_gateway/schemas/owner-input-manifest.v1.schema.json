{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lightcoloror/model-provider-gateway/schemas/owner-input-manifest.v1.schema.json",
  "title": "Model Provider Gateway local owner input manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "purpose", "data_classification", "external_io_authorized", "artifacts", "manifest_revision"
  ],
  "properties": {
    "schema": {"const": "model_provider_gateway.owner_input_manifest.v1"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 256},
    "data_classification": {"enum": ["synthetic_fixture", "public_fixture", "user_authorized_local"]},
    "external_io_authorized": {"const": false},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "sha256", "bytes", "mime_type", "purpose"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 128},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "mime_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$", "maxLength": 128},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "manifest_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
