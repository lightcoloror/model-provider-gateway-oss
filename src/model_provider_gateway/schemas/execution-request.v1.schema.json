{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lightcoloror/model-provider-gateway/schemas/execution-request.v1.schema.json",
  "title": "Model Provider Gateway execution-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "request_id", "consumer_id", "task", "capability",
    "route_id", "route_revision", "profile_id", "profile_revision",
    "provider_id", "model", "consent_hash", "instruction", "artifacts",
    "input_manifest_hash", "max_estimated_cost_usd", "owner_gate_receipt_hash"
  ],
  "properties": {
    "schema": {"const": "model_provider_gateway.execution_request.v1"},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "consumer_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task": {"type": "string", "minLength": 1, "maxLength": 128},
    "capability": {"enum": ["text", "vision"]},
    "route_id": {"type": "string", "minLength": 1},
    "route_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_id": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "consent_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instruction": {"type": "string", "minLength": 1, "maxLength": 32768},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "mime_type", "data_type", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "mime_type": {"enum": ["application/json", "text/markdown", "text/plain", "image/jpeg", "image/png", "image/webp"]},
          "data_type": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "input_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "max_estimated_cost_usd": {"type": "number", "exclusiveMinimum": 0},
    "owner_gate_receipt_hash": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    }
  }
}
